    {"name": "sport on mybets", "routine": {"version": 1, "tz": "Europe/Prague", "sleep": [], "windows": {"tipsport-1": {"blocks": [
      {"id": "a", "days": [1], "from": "08:00", "to": "09:00", "activity": "mybets", "sport": "football"}
    ]}}, "triggers": {"afterBetCheckMyBets": {"on": true, "minMin": 2, "maxMin": 5}}}},
    {"name": "prematch without sport", "routine": {"version": 1, "tz": "Europe/Prague", "sleep": [], "windows": {"tipsport-1": {"blocks": [
      {"id": "a", "days": [1], "from": "08:00", "to": "09:00", "activity": "prematch"}
    ]}}, "triggers": {"afterBetCheckMyBets": {"on": true, "minMin": 2, "maxMin": 5}}}},
    {"name": "bad block id", "routine": {"version": 1, "tz": "Europe/Prague", "sleep": [], "windows": {"tipsport-1": {"blocks": [
      {"id": "B1", "days": [1], "from": "08:00", "to": "09:00", "activity": "mybets"}
