    {"name": "no windows, sleep to midnight", "routine": {"version": 1, "tz": "Europe/Prague", "sleep": [{"days": [7], "from": "22:00", "to": "24:00"}], "windows": {}, "triggers": {"afterBetCheckMyBets": {"on": true, "minMin": 2, "maxMin": 5}}}}
  ],
  "invalid": [
    {"name": "overlapping blocks on a shared day", "routine": {"version": 1, "tz": "Europe/Prague", "sleep": [], "windows": {"tipsport-1": {"blocks": [
      {"id": "a", "days": [1], "from": "08:00", "to": "09:00", "activity": "mybets"},
      {"id": "b", "days": [1, 2], "from": "08:30", "to": "10:00", "activity": "open"}
    ]}}, "triggers": {"afterBetCheckMyBets": {"on": true, "minMin": 2, "maxMin": 5}}}},
    {"name": "from not before to", "routine": {"version": 1, "tz": "Europe/Prague", "sleep": [], "windows": {"tipsport-1": {"blocks": [
      {"id": "a", "days": [1], "from": "09:00", "to": "09:00", "activity": "mybets"}
    ]}}, "triggers": {"afterBetCheckMyBets": {"on": true, "minMin": 2, "maxMin": 5}}}},
    {"name": "to after 24:00", "routine": {"version": 1, "tz": "Europe/Prague", "sleep": [], "windows": {"tipsport-1": {"blocks": [
      {"id": "a", "days": [1], "from": "23:00", "to": "24:30", "activity": "mybets"}
    ]}}, "triggers": {"afterBetCheckMyBets": {"on": true, "minMin": 2, "maxMin": 5}}}},
    {"name": "malformed time", "routine": {"version": 1, "tz": "Europe/Prague", "sleep": [], "windows": {"tipsport-1": {"blocks": [
      {"id": "a", "days": [1], "from": "8:00", "to": "09:00", "activity": "mybets"}
    ]}}, "triggers": {"afterBetCheckMyBets": {"on": true, "minMin": 2, "maxMin": 5}}}},
    {"name": "day 0", "routine": {"version": 1, "tz": "Europe/Prague", "sleep": [], "windows": {"tipsport-1": {"blocks": [
      {"id": "a", "days": [0], "from": "08:00", "to": "09:00", "activity": "mybets"}
    ]}}, "triggers": {"afterBetCheckMyBets": {"on": true, "minMin": 2, "maxMin": 5}}}},
    {"name": "no days", "routine": {"version": 1, "tz": "Europe/Prague", "sleep": [], "windows": {"tipsport-1": {"blocks": [
      {"id": "a", "days": [], "from": "08:00", "to": "09:00", "activity": "mybets"}
    ]}}, "triggers": {"afterBetCheckMyBets": {"on": true, "minMin": 2, "maxMin": 5}}}},
    {"name": "repeated day", "routine": {"version": 1, "tz": "Europe/Prague", "sleep": [], "windows": {"tipsport-1": {"blocks": [
