    {"name": "minMin above maxMin", "routine": {"version": 1, "tz": "Europe/Prague", "sleep": [], "windows": {}, "triggers": {"afterBetCheckMyBets": {"on": true, "minMin": 6, "maxMin": 5}}}},
    {"name": "maxMin above 60", "routine": {"version": 1, "tz": "Europe/Prague", "sleep": [], "windows": {}, "triggers": {"afterBetCheckMyBets": {"on": true, "minMin": 2, "maxMin": 61}}}},
    {"name": "version 2", "routine": {"version": 2, "tz": "Europe/Prague", "sleep": [], "windows": {}, "triggers": {"afterBetCheckMyBets": {"on": true, "minMin": 2, "maxMin": 5}}}},
    {"name": "other zone", "routine": {"version": 1, "tz": "UTC", "sleep": [], "windows": {}, "triggers": {"afterBetCheckMyBets": {"on": true, "minMin": 2, "maxMin": 5}}}},
